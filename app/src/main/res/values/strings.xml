    <string name="toolinfo_emi_title">EMI Hub Guide</string>
    <string name="toolinfo_what_is_emi_title">What is EMI?</string>
    <string name="toolinfo_what_is_emi_desc">An Equated Monthly Installment (EMI) is a fixed payment amount made to a bank or lender every month. It repays both the principal loan amount and accrued interest over a specified period.</string>
    <string name="toolinfo_field_guide_title">Field-by-Field Guide</string>
    <string name="toolinfo_emi_field_guide_desc">Understand what each input field in the calculator and tracker means:</string>
    <string name="toolinfo_field_purchase_price">Purchase Price / Total Amount</string>
    <string name="toolinfo_field_purchase_price_desc">The full cost of the item or the total principal borrowed.</string>
    <string name="toolinfo_field_down_payment">Down Payment</string>
    <string name="toolinfo_field_down_payment_desc">The initial cash payment made upfront. Financing is only calculated on the remaining balance (Price - Down Payment).</string>
    <string name="toolinfo_field_annual_interest">Annual Interest Rate (%)</string>
    <string name="toolinfo_field_annual_interest_desc">The annual percentage rate (APR) charged by the financial institution. Enter 0% for no-cost EMI deals.</string>
    <string name="toolinfo_tenure_months">Tenure (Months)</string>
    <string name="toolinfo_field_emi_tenure_desc">The total duration of the installment plan (e.g., 3, 6, 12, 24, 36 months).</string>
    <string name="toolinfo_field_monthly_due_day">Monthly Due Day</string>
    <string name="toolinfo_field_monthly_due_day_desc">The calendar day of the month (1-31) when your installment is due for reminder notifications.</string>
    <string name="toolinfo_hub_features_title">Hub Features</string>
    <string name="toolinfo_hub_features_desc">• Tracker: Keep track of active EMI liabilities, log paid installments, and link them to your bank or card.\n• Calculator: Interactively simulate monthly installments and total interest with real-time donut chart visualization.\n• Offers: Discover zero-interest and special bank EMI deals.</string>
    <string name="toolinfo_emi_tip">Tip: Use the Calculator to test different down payment amounts to find a monthly installment that comfortably fits your budget.</string>
    <string name="toolinfo_dps_title">DPS &amp; FDR Guide</string>
    <string name="toolinfo_dps_explained_title">DPS vs. FDR Explained</string>
    <string name="toolinfo_dps_explained_desc">• DPS (Deposit Pension Scheme): Regular monthly recurring deposits built over time. Ideal for systematic monthly savings.\n• FDR (Fixed Deposit Receipt): A one-time lump-sum deposit locked for a fixed term to earn higher fixed interest.</string>
    <string name="toolinfo_dps_field_guide_desc">Key parameters used to calculate maturity returns:</string>
    <string name="toolinfo_field_deposit_amount">Monthly / Deposit Amount</string>
    <string name="toolinfo_field_deposit_amount_desc">For DPS, enter your monthly contribution. For FDR, enter the total one-time lump sum.</string>
    <string name="toolinfo_field_interest_rate">Interest Rate (%)</string>
    <string name="toolinfo_field_interest_rate_desc">The annual interest rate offered by the bank.</string>
    <string name="toolinfo_field_dps_tenure_desc">The total duration of the deposit in months (e.g. 12 months for 1 year, 60 months for 5 years).</string>
    <string name="toolinfo_field_compounding">Compounding Frequency</string>
    <string name="toolinfo_field_compounding_desc">How often interest is calculated and added to the principal (Monthly, Quarterly, Half-Yearly, or Yearly). More frequent compounding yields higher final returns.</string>
    <string name="toolinfo_field_tin">TIN (Tax Identification Number)</string>
    <string name="toolinfo_field_tin_desc">In Bangladesh, having a TIN reduces the Source Tax (AIT) on interest from 15% down to 10%.</string>
    <string name="toolinfo_premature_title">Premature Cashout Simulation</string>
    <string name="toolinfo_premature_desc">Our engine estimates how much you would receive if you break your deposit early at a premature penalty rate.</string>
    <string name="toolinfo_dps_tip">Tip: Toggle the \'I have a TIN\' switch to see how your net maturity payout increases with reduced source tax!</string>
