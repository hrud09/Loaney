    <string name="toolinfo_emi_title">EMI হাব গাইড</string>
    <string name="toolinfo_what_is_emi_title">EMI কী?</string>
    <string name="toolinfo_what_is_emi_desc">সমান মাসিক কিস্তি (EMI) হলো প্রতি মাসে ব্যাংক বা ঋণদাতাকে দেওয়া একটি নির্দিষ্ট পরিমাণ পরিশোধ। এটি নির্দিষ্ট সময়ের মধ্যে মূল ঋণ ও জমা হওয়া সুদ উভয়ই পরিশোধ করে।</string>
    <string name="toolinfo_field_guide_title">প্রতিটি ঘরের গাইড</string>
    <string name="toolinfo_emi_field_guide_desc">ক্যালকুলেটর ও ট্র্যাকারের প্রতিটি ইনপুট ঘর কী বোঝায় তা জেনে নিন:</string>
    <string name="toolinfo_field_purchase_price">ক্রয়মূল্য / মোট পরিমাণ</string>
    <string name="toolinfo_field_purchase_price_desc">পণ্যটির সম্পূর্ণ মূল্য অথবা মোট নেওয়া মূল ঋণের পরিমাণ।</string>
    <string name="toolinfo_field_down_payment">ডাউন পেমেন্ট</string>
    <string name="toolinfo_field_down_payment_desc">শুরুতে নগদে দেওয়া প্রাথমিক পেমেন্ট। ফাইন্যান্সিং শুধু অবশিষ্ট ব্যালেন্সের উপর হিসাব করা হয় (মূল্য - ডাউন পেমেন্ট)।</string>
    <string name="toolinfo_field_annual_interest">বার্ষিক সুদের হার (%)</string>
    <string name="toolinfo_field_annual_interest_desc">আর্থিক প্রতিষ্ঠান কর্তৃক ধার্য করা বার্ষিক শতকরা হার (APR)। কোনো খরচবিহীন EMI অফারের জন্য 0% লিখুন।</string>
    <string name="toolinfo_tenure_months">মেয়াদ (মাস)</string>
    <string name="toolinfo_field_emi_tenure_desc">কিস্তি পরিকল্পনার মোট সময়কাল (যেমন, 3, 6, 12, 24, 36 মাস)।</string>
    <string name="toolinfo_field_monthly_due_day">মাসিক পরিশোধের দিন</string>
    <string name="toolinfo_field_monthly_due_day_desc">মাসের যে তারিখে (1-31) আপনার কিস্তি পরিশোধযোগ্য, যাতে রিমাইন্ডার নোটিফিকেশন পাঠানো যায়।</string>
    <string name="toolinfo_hub_features_title">হাব ফিচার</string>
    <string name="toolinfo_hub_features_desc">• ট্র্যাকার: সক্রিয় EMI দায় ট্র্যাক করুন, পরিশোধিত কিস্তি লগ করুন এবং সেগুলো আপনার ব্যাংক বা কার্ডের সাথে যুক্ত করুন।\n• ক্যালকুলেটর: রিয়েল-টাইম ডোনাট চার্টের মাধ্যমে মাসিক কিস্তি ও মোট সুদ ইন্টারঅ্যাক্টিভভাবে হিসাব করুন।\n• অফার: শূন্য সুদ ও বিশেষ ব্যাংক EMI অফার খুঁজে নিন।</string>
    <string name="toolinfo_emi_tip">টিপ: বিভিন্ন ডাউন পেমেন্টের পরিমাণ পরীক্ষা করতে ক্যালকুলেটর ব্যবহার করুন, যাতে আপনার বাজেটের সাথে স্বাচ্ছন্দ্যে মানানসই মাসিক কিস্তি খুঁজে পান।</string>
    <string name="toolinfo_dps_title">DPS ও FDR গাইড</string>
    <string name="toolinfo_dps_explained_title">DPS বনাম FDR ব্যাখ্যা</string>
    <string name="toolinfo_dps_explained_desc">• DPS (ডিপোজিট পেনশন স্কিম): সময়ের সাথে গড়ে ওঠা নিয়মিত মাসিক জমা। নিয়মিত মাসিক সঞ্চয়ের জন্য আদর্শ।\n• FDR (ফিক্সড ডিপোজিট রিসিট): একবারে জমা করা এককালীন অর্থ, যা উচ্চ নির্দিষ্ট সুদ পেতে একটি নির্দিষ্ট মেয়াদের জন্য আটকে রাখা হয়।</string>
    <string name="toolinfo_dps_field_guide_desc">মেয়াদপূর্তির রিটার্ন হিসাব করতে ব্যবহৃত মূল প্যারামিটারসমূহ:</string>
    <string name="toolinfo_field_deposit_amount">মাসিক / জমার পরিমাণ</string>
    <string name="toolinfo_field_deposit_amount_desc">DPS-এর জন্য আপনার মাসিক জমার পরিমাণ লিখুন। FDR-এর জন্য এককালীন মোট পরিমাণ লিখুন।</string>
    <string name="toolinfo_field_interest_rate">সুদের হার (%)</string>
    <string name="toolinfo_field_interest_rate_desc">ব্যাংক কর্তৃক প্রদত্ত বার্ষিক সুদের হার।</string>
    <string name="toolinfo_field_dps_tenure_desc">মাসে জমার মোট সময়কাল (যেমন 1 বছরের জন্য 12 মাস, 5 বছরের জন্য 60 মাস)।</string>
